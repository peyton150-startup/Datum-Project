DATUM_SECRET_KEY=dev-insecure-key-not-for-production
# Intent repository (ADR-004). Polled by the celery beat worker.
# Empty URL disables polling entirely.
DATUM_INTENT_REPO_URL=
DATUM_INTENT_REPO_BRANCH=main
DATUM_INTENT_POLL_SECONDS=300
DATUM_DEBUG=1
POSTGRES_DB=datum
POSTGRES_USER=datum
POSTGRES_PASSWORD=datum
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
VALKEY_URL=redis://localhost:6379/0

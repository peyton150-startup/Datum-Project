.ruff_cache/
.coverage
htmlcov/

# Node / web
node_modules/
dist/
.vite/
*.log

# Env & secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# OS / editor
.DS_Store
Thumbs.db
.idea/
